# Maintainer: karsyboy
#
# pyroshine-bin and pyroshine-ui-bin repackage the Arch packages that
# Pyroshine's release workflow builds with nfpm (nfpm.yaml and nfpm-ui.yaml in
# karsyboy/pyroshine); keep depends in sync with their archlinux overrides.
# scripts/sync.sh sets pkgver and checksums for new releases.

pkgbase=pyroshine-bin
pkgname=(pyroshine-bin pyroshine-ui-bin)
pkgver=0.17.3
pkgrel=1
pkgdesc='Pyroshine game-streaming host for Moonlight clients, with native PyroWave support'
arch=('x86_64')
url='https://github.com/karsyboy/pyroshine'
license=('BSD-2-Clause')
# Release binaries are already stripped; the bundled PyroWave library is pinned.
options=('!strip' '!debug')
_release="${url}/releases/download/v${pkgver}"
# Renamed so the downloaded nfpm packages are not mistaken for makepkg output.
source=("pyroshine-${pkgver}-nfpm.tar.zst::${_release}/pyroshine-${pkgver}-1-x86_64.pkg.tar.zst"
        "pyroshine-ui-${pkgver}-nfpm.tar.zst::${_release}/pyroshine-ui-${pkgver}-1-x86_64.pkg.tar.zst")
noextract=("pyroshine-${pkgver}-nfpm.tar.zst"
           "pyroshine-ui-${pkgver}-nfpm.tar.zst")
sha256sums=('25d5aa89983a0306a15114019c0ae6baefe26fa2a5b09a4f98309d62421d2e17'
            'abc33c7429067cf9f4de5b4f501ade0fc342a47fc0a56cc90d02c8de5abc311e')

_extract() {
  # nfpm's .PKGINFO/.MTREE/.INSTALL are replaced by this PKGBUILD's metadata.
  bsdtar -xf "$1" -C "$pkgdir" --exclude '.PKGINFO' --exclude '.MTREE' \
    --exclude '.INSTALL' --exclude '.BUILDINFO'
}

package_pyroshine-bin() {
  depends=('glibc>=2.39' 'libgcc' 'libstdc++' 'libdrm' 'libevdev' 'libffi' 'libxkbcommon'
           'mesa' 'opus' 'vulkan-icd-loader' 'wayland' 'xorg-xwayland')
  optdepends=('vulkan-driver: hardware Vulkan for PyroWave encoding'
              'pyroshine-ui-bin: system tray, pairing and settings app')
  provides=("pyroshine=${pkgver}")
  conflicts=('pyroshine')
  install=pyroshine-bin.install

  _extract "$srcdir/pyroshine-${pkgver}-nfpm.tar.zst"
  mv "$pkgdir/usr/share/licenses/pyroshine" "$pkgdir/usr/share/licenses/$pkgname"
}

package_pyroshine-ui-bin() {
  pkgdesc='Desktop app for the Pyroshine streaming server: tray, pairing, clients, settings and stream dashboard'
  depends=("pyroshine=${pkgver}" 'cairo' 'dbus' 'gdk-pixbuf2' 'glib2' 'glibc>=2.39'
           'gtk3' 'hicolor-icon-theme' 'libgcc' 'libsoup3' 'webkit2gtk-4.1')
  provides=("pyroshine-ui=${pkgver}")
  conflicts=('pyroshine-ui')
  backup=('etc/xdg/autostart/pyroshine-ui.desktop')
  install=pyroshine-ui-bin.install

  _extract "$srcdir/pyroshine-ui-${pkgver}-nfpm.tar.zst"
  mv "$pkgdir/usr/share/licenses/pyroshine-ui" "$pkgdir/usr/share/licenses/$pkgname"
}
